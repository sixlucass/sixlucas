local function isRealName(n)
	if type(n) ~= "string" or n == "" then
		return false
	end
	if n:find("%[") or n:upper():find("UNAVAILABLE") then
		return false
	end
	if nonGameNames[n:lower()] then
		return false
	end
	return true
end

local gameNameCache = {}

local function getGameName(p, place, universe)
	place = positiveId(place)
	universe = positiveId(universe) or resolveUniverse(place)
	local key = universe and ("u" .. universe) or (place and ("p" .. place))
	local cached = key and gameNameCache[key]
	if cached then
		return cached, universe
	end
	if universe then
		local d = call("GET", "https://games.roblox.com/v1/games?universeIds=" .. universe)
		local g = d and d.data and d.data[1]
		if g and isRealName(g.name) then
			if key then
				gameNameCache[key] = g.name
			end
			return g.name, universe
		end
	end
	if isRealName(p.lastLocation) then
		if key then
			gameNameCache[key] = p.lastLocation
		end
		return p.lastLocation, universe
	end
	if place then
		local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, place)
		if ok and info and isRealName(info.Name) then
			if key then
				gameNameCache[key] = info.Name
			end
			return info.Name, universe
		end
	end
	return nil, universe
end

local function isBlocked(id)

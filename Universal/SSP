local httpFn = (typeof(request) == "function" and request)
	or (typeof(http_request) == "function" and http_request)
	or (syn and syn.request)
	or (http and http.request)
	or (fluxus and fluxus.request)

local function call(method, url, body)
	local opts = {
		Url = url,
		Method = method,
		Headers = {["Content-Type"] = "application/json"},
		Body = body and HttpService:JSONEncode(body) or nil,
	}
	local ok, res
	if httpFn then
		ok, res = pcall(httpFn, opts)
	else
		local okReq, success, response = pcall(HttpService.RequestAsync, HttpService, opts)
		ok = okReq and success
		res = response
	end
	local raw = ok and type(res) == "table" and ((type(res.Body) == "string" and res.Body ~= "" and res.Body) or res.body)
	if not raw and method == "GET" then
		local okGet, got = pcall(function()
			return game:HttpGet(url)
		end)
		raw = okGet and got
	end
	if type(raw) ~= "string" or raw == "" then
		return nil
	end
	local good, data = pcall(HttpService.JSONDecode, HttpService, raw)
	return good and data or nil
end

function positiveId(id)
	local n = tonumber(id)
	return n and n > 0 and n or nil
end

local userCache = {}

local function rememberUser(query, id, name, display)
	local rec = {id = id, name = name, display = display or name, displayName = display or name}
	if type(query) == "string" and query ~= "" then
		userCache[query:lower()] = rec
	end
	if type(name) == "string" and name ~= "" then
		userCache[name:lower()] = rec
	end
	if type(display) == "string" and display ~= "" then
		userCache[display:lower()] = rec
	end
	return rec
end

local universeCache = {}

local function resolveUniverse(place)
	place = positiveId(place)
	if not place then
		return nil
	end
	local cached = universeCache[place]
	if cached then
		return cached
	end
	local d = call("GET", "https://apis.roblox.com/universes/v1/places/" .. place .. "/universe")
	local universe = d and positiveId(d.universeId) or nil
	if universe then
		universeCache[place] = universe
	end
	return universe
end
local thumbCache = {}
local avatarUrlCache = {}
local avatarUrlPending = {}
local canUseAssets = typeof(getcustomasset) == "function" and typeof(writefile) == "function"

local function applyImage(img, key, url)
	if not url or url == "" then
		return
	end
	if thumbCache[key] then
		if img:GetAttribute("Key") == key then
			img.Image = thumbCache[key]
		end
		return
	end
	task.spawn(function()
		if not canUseAssets then
			return
		end
		local ok, bytes = pcall(function()
			return game:HttpGet(url)
		end)
		if not ok or type(bytes) ~= "string" or #bytes == 0 then
			return
		end
		local safeKey = (key:gsub("%W", "_"))
		local file = "SSP_" .. safeKey .. ".png"
		pcall(writefile, file, bytes)
		local okA, asset = pcall(getcustomasset, file)
		if okA and asset then
			thumbCache[key] = asset
			if img.Parent and img:GetAttribute("Key") == key then
				img.Image = asset
			end
		end
	end)
end

loadAvatar = function(img, userId)
	if not img then

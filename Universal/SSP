		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = SectionsContainer,
	}, {
		create("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder}),
		create("UIPadding", {PaddingTop = UDim.new(0, 1), PaddingBottom = UDim.new(0, 1), PaddingLeft = UDim.new(0, 1)}),
	})

	local empty = label({
		Name = "Empty",
		AnchorPoint = Vector2.new(0, 0),
		Size = UDim2.new(1, -8, 0, 40),
		Text = "Nothing here yet.",
		TextScaled = false,
		TextSize = 14,
		TextColor3 = col.dim,
		LayoutOrder = -1e9,
		Parent = sf,
	})
	emptyLabels[sf] = empty

	local function refresh()
		for _, child in ipairs(sf:GetChildren()) do
			if child:GetAttribute("IsRow") and not child:GetAttribute("IsHeader") then
				empty.Visible = false
				return
			end
		end
		empty.Visible = true
	end
	sf.ChildAdded:Connect(refresh)
	sf.ChildRemoved:Connect(refresh)

	return sf
end


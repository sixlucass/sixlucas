function refreshServer()
	if destroyed or not positiveId then
		return
	end
	serverRefreshId += 1
	local gen = serverRefreshId
	clearList(ServerList)

	local others = {}
	local currentIds = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			currentIds[p.UserId] = true
			table.insert(others, p)
		end
	end
	table.sort(others, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	if #others > 0 then
		addSection("IN YOUR SERVER", nextOrder())
	end

	for _, p in ipairs(others) do
		local row = makeRow(ServerList, {
			title = p.DisplayName,
			sub = "@" .. p.Name .. "  •  In game",
			avatar = headshot(p.UserId),
			platform = platformFromPresence(p) or "unknown",
			order = nextOrder(),
			noFade = true,
			onClick = function()
				snipe(p.Name)
			end,
		}, "crosshair", function()
			snipe(p.Name)
		end)
		if loadAvatar then
			loadAvatar(row:FindFirstChild("Avatar"), p.UserId)
		end
		task.spawn(function()
			local ok, friend = pcall(LocalPlayer.IsFriendsWith, LocalPlayer, p.UserId)
			if ok and friend and row.Parent then
				row.Sub.Text = "@" .. p.Name .. "  •  In game  •  Friend"
				row.Sub.TextColor3 = col.green
			end
		end)
	end

	task.spawn(function()
		if not getFriends or not getPresenceBatch then
			return
		end
		local friends = getFriends()
		if destroyed or gen ~= serverRefreshId then
			return
		end

		local ids = {}
		for _, f in ipairs(friends) do
			if not currentIds[f.id] then
				table.insert(ids, f.id)
			end
		end
		if #ids == 0 then
			return
		end

		local presences = getPresenceBatch(ids)
		if destroyed or gen ~= serverRefreshId then
			return
		end

		local entries = {}
		for _, f in ipairs(friends) do
			if not currentIds[f.id] then
				local p = presences[f.id]
				local kind = p and p.userPresenceType
				if kind == 1 or kind == 2 then
					local place = p and (positiveId(p.placeId) or positiveId(p.rootPlaceId))
					local job = p and p.gameId
					local joinable = kind == 2 and place ~= nil and type(job) == "string" and job ~= ""
					table.insert(entries, {
						friend = f,
						presence = p,
						kind = kind,
						place = place,
						job = job,
						joinable = joinable,
					})
				end
			end
		end

		table.sort(entries, function(a, b)
			local function rank(e)
				if e.kind == 2 then
					return e.joinable and 1 or 2
				end
				return 3
			end
			local ra, rb = rank(a), rank(b)
			if ra ~= rb then
				return ra < rb
			end
			local an = (a.friend.displayName or a.friend.name or ""):lower()
			local bn = (b.friend.displayName or b.friend.name or ""):lower()
			return an < bn
		end)

		if #entries == 0 then
			return
		end

		addSection("FRIENDS ONLINE", nextOrder())

		for _, e in ipairs(entries) do
			local f = e.friend
			local inGame = e.kind == 2
			local status
			if inGame then
				status = e.joinable and "In game  •  Joins on" or "In game  •  Joins off"
			else
				status = "Online  •  Not in game"
			end

			local function joinFriend()
				if not e.joinable then
					snipe(f.name)
					return
				end
				current = {place = e.place, job = e.job, inServer = false}
				joinCurrent()
			end

			local platform = platformFromPresence(Players:GetPlayerByUserId(f.id)) or platformFromPresence(e.presence) or "unknown"

			local row = makeRow(ServerList, {
				title = f.displayName or f.name,
				sub = "@" .. f.name .. "  •  " .. status,
				avatar = headshot(f.id),
				platform = platform,
				order = nextOrder(),
				noFade = true,
				onClick = joinFriend,
			}, e.joinable and "play" or "crosshair", joinFriend)
			row.Sub.TextColor3 = e.joinable and col.green or (inGame and col.red or col.blue)
			if loadAvatar then
				loadAvatar(row:FindFirstChild("Avatar"), f.id)
			end
		end
	end)
end


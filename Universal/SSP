local function normalizePlatform(raw)
	if typeof(raw) == "EnumItem" then
		raw = raw.Name
	end
	if type(raw) ~= "string" then
		return nil
	end
	local s = raw:lower():gsub("[%s_%-]", "")
	if s == "" or s == "none" or s == "unknown" then
		return nil
	end
	if s:find("androidtv", 1, true)
		or s:find("xbox", 1, true)
		or s:find("playstation", 1, true)
		or s:find("ps3", 1, true)
		or s:find("ps4", 1, true)
		or s:find("ps5", 1, true)
		or s:find("wiiu", 1, true)
		or s == "nx"
		or s:find("ouya", 1, true)
		or s:find("chromecast", 1, true)
		or s:find("console", 1, true)
		or s:find("gamepad", 1, true)
		or s:find("metaos", 1, true)
		or s:find("quest", 1, true)
		or s == "vr"
	then
		return "console"
	end
	if s:find("ios", 1, true)
		or s:find("iphone", 1, true)
		or s:find("ipad", 1, true)
		or s:find("android", 1, true)
		or s:find("mobile", 1, true)
		or s:find("phone", 1, true)
		or s:find("tablet", 1, true)
	then
		return "mobile"
	end
	if s:find("windows", 1, true)
		or s:find("win", 1, true)
		or s:find("osx", 1, true)
		or s:find("mac", 1, true)
		or s:find("linux", 1, true)
		or s:find("steamos", 1, true)
		or s:find("desktop", 1, true)
		or s:find("pc", 1, true)
		or s:find("computer", 1, true)
		or s:find("uwp", 1, true)
		or s:find("web", 1, true)
	then
		return "pc"
	end
	return nil
end

local function localPlatform()
	local ok, platform = pcall(function()
		return UserInputService:GetPlatform()
	end)
	if ok then
		local mapped = normalizePlatform(platform)
		if mapped then
			return mapped
		end
	end
	local okFoot, tenFoot = pcall(function()
		return GuiService:IsTenFootInterface()
	end)
	if okFoot and tenFoot then
		return "console"
	end
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and not UserInputService.MouseEnabled then
		return "mobile"
	end
	if UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
		return "console"
	end
	return "pc"
end

local function platformFromPresence(p)
	if p == nil then
		return nil
	end
	local raw
	if typeof(p) ~= "Instance" then
		raw = p.deviceType or p.device or p.platform or p.lastDevice or p.deviceTypeId
	end
	if raw == nil then
		local ok, value = pcall(function()
			return p.PlatformName
		end)
		if ok then
			raw = value
		end
	end
	if raw == nil then
		local ok, value = pcall(function()
			return p.OsPlatform
		end)
		if ok then
			raw = value
		end
	end
	local mapped = normalizePlatform(raw)
	if mapped then
		return mapped
	end
	if p == LocalPlayer then
		return localPlatform()
	end
	return nil
end


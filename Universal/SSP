local function paint(btn, state, t)
	local ic = btn:FindFirstChild("Icon")
	if t and t > 0 then
		tween(btn, t, {BackgroundColor3 = state.bg})
		if ic and ic:IsA("ImageLabel") and state.ic then
			tween(ic, t, {ImageColor3 = state.ic})
		end
	else
		btn.BackgroundColor3 = state.bg
		if ic and ic:IsA("ImageLabel") and state.ic then
			ic.ImageColor3 = state.ic
		end
	end
end

local function buttonFx(btn, normal, hovered, isActive)
	normal = normal or idle
	hovered = hovered or hover
	local scale = btn:FindFirstChildOfClass("UIScale") or create("UIScale", {Parent = btn})
	local function active()
		return isActive and isActive()
	end
	btn.MouseEnter:Connect(function()
		if not active() then
			paint(btn, hovered, 0.08)
		end
	end)
	btn.MouseLeave:Connect(function()
		tween(scale, 0.12, {Scale = 1})
		if not active() then
			paint(btn, normal, 0.12)
		end
	end)
	btn.MouseButton1Down:Connect(function()
		tween(scale, 0.05, {Scale = 0.9})
	end)
	btn.MouseButton1Up:Connect(function()
		tween(scale, 0.2, {Scale = 1}, Enum.EasingStyle.Back)
	end)
end


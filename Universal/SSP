	return false
end

local function ago(iso)
	local ok, dt = pcall(DateTime.fromIsoDate, iso)
	if not ok or not dt then
		return nil
	end
	local diff = os.time() - dt.UnixTimestamp
	if diff < 60 then
		return "just now"
	elseif diff < 3600 then
		return math.floor(diff / 60) .. "m ago"
	elseif diff < 86400 then
		return math.floor(diff / 3600) .. "h ago"
	end
	return math.floor(diff / 86400) .. "d ago"
end

local busy = false
local searchId = 0
local autoToken = 0
local autoTarget = nil
local joining = false

local function search(query)
	if busy or destroyed then
		return
	end
	local q = tostring(query or InpBox.Text):match("^%s*(.-)%s*$")
	if q == "" then
		shake(InputFrame, inputPos)
		toast("Enter a username", col.red)
		return
	end

	searchId += 1
	local sid = searchId
	autoToken += 1
	busy = true
	current = nil
	autoTarget = nil
	Placeholder.Visible = false
	Body.Visible = true
	Actions.Visible = false
	Avatar:SetAttribute("Key", "")
	GameImage:SetAttribute("Key", "")
	Avatar.Image = ""
	GameImage.Image = ""
	applyPlatformBadge(PlatformBadge, nil)
	NameLbl.Text = q
	SubLbl.Text = ""
	GameCaption.Text = "GAME"
	GameLbl.Text = "-"
	clearPills()
	addPill("Searching...", col.dim, true)

	task.spawn(function()
		local id, name, display = findUser(q)
		if destroyed or sid ~= searchId then
			return
		end

		id = positiveId(id)
		if not id then
			clearPills()
			addPill("Not found", col.red, true)
			GameLbl.Text = "No player with that name"
			busy = false
			return
		end

		name = name or q
		display = display or name
		autoTarget = {id = id, name = name, display = display}
		NameLbl.Text = display
		SubLbl.Text = ("@%s  •  ID %d"):format(name, id)
		loadAvatar(Avatar, id)

		local inServerPlayer = Players:GetPlayerByUserId(id)
		local inServer = inServerPlayer ~= nil
		local p
		if inServer then
			p = {
				userPresenceType = 2,
				placeId = game.PlaceId,
				rootPlaceId = game.PlaceId,
				universeId = game.GameId,
				gameId = game.JobId,
			}
		else
			p = getPresence(id, autoSnipe)
		end
		if destroyed or sid ~= searchId then
			return
		end

		local kind = p and p.userPresenceType
		if p and (kind == 2 or inServer) then
			local platform
			if id == LocalPlayer.UserId then
				platform = localPlatform()
			else
				platform = platformFromPresence(inServerPlayer) or platformFromPresence(p) or "unknown"
			end
			applyPlatformBadge(PlatformBadge, platform)
		else
			applyPlatformBadge(PlatformBadge, nil)
		end
		clearPills()
		local showActions = false

		if not p then
			addPill("Request failed", col.red, true)
			GameLbl.Text = "Try again in a few seconds"
		elseif kind == 2 or inServer then
			addPill("In game", col.green, true)
			GameCaption.Text = "GAME"
			GameLbl.Text = "Looking up..."

			local place = positiveId(p.placeId) or positiveId(p.rootPlaceId)
			local universe = positiveId(p.universeId)
			local job = p.gameId
			if inServer then
				place, universe, job = positiveId(game.PlaceId), positiveId(game.GameId), game.JobId
			end

			current = {place = place, job = job, inServer = inServer}
			if not inServer then
				local canJoin = job ~= nil and job ~= ""
				addPill(canJoin and "Joins on" or "Joins off", canJoin and col.green or col.red)
			end
			if place then
				showActions = true
				layoutActions(job ~= nil and job ~= "" and not inServer)
			end
			if place or universe then
				task.spawn(function()
					local resolved = positiveId(universe)
					if not resolved and place then
						resolved = resolveUniverse(place)
						if destroyed or sid ~= searchId then
							return
						end
					end
					if not resolved or destroyed or sid ~= searchId then
						return
					end
					loadGameIcon(GameImage, resolved, place)
				end)
			end

			if inServer and isRealName(game.Name) then
				GameLbl.Text = game.Name
			else
				task.spawn(function()
					local gameName = getGameName(p, place, universe)
					if destroyed or sid ~= searchId then
						return
					end
					GameLbl.Text = gameName or "Hidden by privacy settings"
				end)
			end
		elseif kind == 1 then
			addPill("Online", col.blue, true)
			GameCaption.Text = "STATUS"
			GameLbl.Text = "Not in a game"
		elseif kind == 3 then
			addPill("In Studio", col.orange, true)
			GameCaption.Text = "STATUS"
			GameLbl.Text = "Editing in Studio"
		else
			addPill("Offline", col.dim, true)
			local seen = p.lastOnline and ago(p.lastOnline)
			GameCaption.Text = "LAST ONLINE"
			GameLbl.Text = seen or "Unknown"
		end

		Actions.Visible = showActions
		busy = false

		if autoSnipe and sid == searchId then
			if inServer then
				toast("Already in your server", col.blue)
			elseif current and current.place and current.job and current.job ~= "" then
				tryAutoJoin()
			elseif autoTarget then
				startAutoPoll(autoTarget)
			end
		end

		if id == LocalPlayer.UserId then
			addPill("You", col.white)
		else
			local ok, friend = pcall(LocalPlayer.IsFriendsWith, LocalPlayer, id)
			if destroyed or sid ~= searchId then
				return
			end
			addPill(ok and friend and "Friend" or "Not friends", ok and friend and col.green or col.dim)
			if isBlocked(id) then
				addPill("Blocked", col.red)
			end
			if inServer then
				addPill("In your server", col.blue)
			elseif current and current.place == game.PlaceId then
				addPill("Same game as you", col.blue)
			end
		end
	end)
end

function tryAutoJoin()
	if joining or not autoSnipe or destroyed or not current or not current.place or not current.job or current.job == "" or current.inServer then
		return false
	end
	autoToken += 1
	local token = autoToken
	local target = autoTarget
	toast("AutoSnipe: joining...", col.green)
	task.delay(0.15, function()
		if autoSnipe and not destroyed and autoToken == token then
			local joined = joinCurrent()
			if joined then
				local watchToken = autoToken
				task.delay(10, function()
					if autoSnipe and not destroyed and autoToken == watchToken and autoTarget == target and not joining then
						if target and target.id and not Players:GetPlayerByUserId(target.id) then
							startAutoPoll(target)
						end
					end
				end)
			elseif autoSnipe and not destroyed and autoTarget == target and not joining then
				task.delay(2.5, function()
					if autoSnipe and not destroyed and autoTarget == target and not joining then
						startAutoPoll(target)
					end
				end)
			end
		end
	end)
	return true
end

function startAutoPoll(target)
	if not target or not target.id then
		return
	end
	autoToken += 1
	local token = autoToken
	toast("AutoSnipe: waiting for " .. (target.display or target.name or "target"), col.blue)
	task.spawn(function()
		while autoSnipe and not destroyed and autoToken == token do
			task.wait(2)
			if not autoSnipe or destroyed or autoToken ~= token then
				break
			end
			local p = getPresence(target.id, true)
			if not autoSnipe or destroyed or autoToken ~= token then
				break
			end
			if p and p.userPresenceType == 2 and p.gameId and p.gameId ~= "" and (positiveId(p.placeId) or positiveId(p.rootPlaceId)) then
				if not busy and not joining then
					search(target.name)
					return
				end
			end
		end
	end)
end

function setAutoSnipe(on)
	on = on and true or false
	if autoSnipe == on then
		return
	end
	autoSnipe = on
	autoToken += 1
	if not on then
		autoTarget = nil
	end
	refreshAutoUI()
	toast(on and "AutoSnipe ON" or "AutoSnipe OFF", on and col.green or col.dim)
	if not on then
		return
	end
	if current and current.place and current.job and current.job ~= "" and not current.inServer then
		tryAutoJoin()
	elseif current and current.inServer then
		toast("Already in your server", col.blue)
	elseif autoTarget then
		startAutoPoll(autoTarget)
	elseif InpBox.Text:match("%S") then
		search()
	end
end

function setAntiAfk(on)
	on = on and true or false
	if antiAfk == on then
		return
	end
	antiAfk = on
	refreshAntiAfkUI()
	toast(on and "Anti-AFK ON" or "Anti-AFK OFF", on and col.green or col.dim)
end

bind(LocalPlayer.Idled, function()
	if not antiAfk or destroyed or not VirtualUser then
		return
	end
	pcall(function()
		VirtualUser:CaptureController()
		VirtualUser:ClickButton2(Vector2.new())
	end)
end)

function joinCurrent()
	if joining or destroyed then
		return false
	end
	if not current or not current.place or not current.job or current.job == "" then
		toast("No joinable server", col.red)
		return false
	end
	if current.inServer then
		toast("Already in your server", col.blue)
		return false
	end
	autoToken += 1
	joining = true
	toast("Joining...", col.green)
	local ok = pcall(TeleportService.TeleportToPlaceInstance, TeleportService, current.place, current.job, LocalPlayer)
	if not ok then
		joining = false
		toast("Join blocked — joins may be off", col.red)
		return false
	end
	task.delay(8, function()
		joining = false
	end)
	return true
end

bind(TeleportService.TeleportInitFailed, function(_, _, message)
	local wasJoining = joining
	joining = false
	if not destroyed then
		toast("Join failed: " .. tostring(message or "blocked"), col.red)
	end
	local target = autoTarget
	if wasJoining and autoSnipe and not destroyed and target then
		task.delay(3, function()
			if autoSnipe and not destroyed and autoTarget == target and not joining then
				startAutoPoll(target)
			end
		end)
	end
end)


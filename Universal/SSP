local function findUser(query)
	local q = query:lower()
	local hit = userCache[q]
	if hit then
		return hit.id, hit.name, hit.display
	end

	local list = Players:GetPlayers()

	for _, p in ipairs(list) do
		if p.Name:lower() == q or p.DisplayName:lower() == q then
			local rec = rememberUser(q, p.UserId, p.Name, p.DisplayName)
			return rec.id, rec.name, rec.display
		end
	end

	local exact = call("POST", "https://users.roblox.com/v1/usernames/users", {
		usernames = {query},
		excludeBannedUsers = false,
	})
	local u = exact and exact.data and exact.data[1]
	if u then
		local rec = rememberUser(q, u.id, u.name, u.displayName)
		return rec.id, rec.name, rec.display
	end

	for _, p in ipairs(list) do
		if p.Name:lower():find(q, 1, true) or p.DisplayName:lower():find(q, 1, true) then
			local rec = rememberUser(q, p.UserId, p.Name, p.DisplayName)
			return rec.id, rec.name, rec.display
		end
	end

	local found = call("GET", "https://users.roblox.com/v1/users/search?limit=10&keyword=" .. HttpService:UrlEncode(query))
	local results = found and found.data
	if results and #results > 0 then
		local pick = results[1]
		for _, r in ipairs(results) do
			if r.name:lower():sub(1, #q) == q then
				pick = r
				break
			end
		end
		local rec = rememberUser(q, pick.id, pick.name, pick.displayName)
		return rec.id, rec.name, rec.display
	end
end

local presenceCache = {}
local PRESENCE_TTL = 5

local function getPresence(id, force)
	id = positiveId(id)
	if not id then
		return nil
	end
	local now = os.time()
	local cached = presenceCache[id]
	if not force and cached and now - cached.at < PRESENCE_TTL then
		return cached.data
	end
	local d = call("POST", "https://presence.roblox.com/v1/presence/users", {userIds = {id}})
	local p = d and d.userPresences and d.userPresences[1]
	presenceCache[id] = {at = now, data = p}
	return p
end

function getPresenceBatch(ids)
	local out = {}
	local now = os.time()
	for i = 1, #ids, 100 do
		local chunk = {}
		for j = i, math.min(i + 99, #ids) do
			chunk[#chunk + 1] = ids[j]
		end
		local d = call("POST", "https://presence.roblox.com/v1/presence/users", {userIds = chunk})
		if d and d.userPresences then
			for _, p in ipairs(d.userPresences) do
				local id = positiveId(p.userId)
				if id then
					out[id] = p
					presenceCache[id] = {at = now, data = p}
				end
			end
		end
	end
	return out
end

local friendsCache, friendsCacheAt, friendsCacheOk

function getFriends(force)
	local now = os.time()
	local ttl = friendsCacheOk and 30 or 10
	if not force and friendsCache and now - friendsCacheAt < ttl then
		return friendsCache
	end

	local out = {}
	local seen = {}
	local function addFriend(id, name, display)
		if id and not seen[id] then
			seen[id] = true
			local rec = rememberUser(name, id, name, display or name)
			table.insert(out, rec)
		end
	end

	local ok = pcall(function()
		local pages = LocalPlayer:GetFriendsAsync()
		while true do
			for _, item in ipairs(pages:GetCurrentPage()) do
				local id = positiveId(item.Id)
				if id then
					local name = item.Username or item.Name or ("User" .. id)
					addFriend(id, name, item.DisplayName or name)
				end
			end
			if pages.IsFinished then
				break
			end
			pages:AdvanceToNextPageAsync()
		end
	end)

	if not ok or #out == 0 then
		local cursor
		for _ = 1, 10 do
			local url = ("https://friends.roblox.com/v1/users/%d/friends"):format(LocalPlayer.UserId)
			if cursor and cursor ~= "" then
				url = url .. "?cursor=" .. HttpService:UrlEncode(cursor)
			end
			local d = call("GET", url)
			local list = d and d.data
			if type(list) ~= "table" then
				break
			end
			for _, f in ipairs(list) do
				local id = positiveId(f.id)
				if id then
					local name = f.name or f.displayName or ("User" .. id)
					addFriend(id, name, f.displayName or name)
				end
			end
			cursor = d.nextPageCursor
			if not cursor or cursor == "" then
				break
			end
		end
	end

	friendsCache = out
	friendsCacheAt = now
	friendsCacheOk = ok and #out > 0
	return out
end

local nonGameNames = {
	website = true,
	mobile = true,
	roblox = true,
	studio = true,
	unknown = true,
	offline = true,
	online = true,
	["in game"] = true,

local function lucide(img, names)
	if not Lucide then
		return false
	end
	for _, n in ipairs(type(names) == "table" and names or {names}) do
		local ok, a = pcall(Lucide.GetAsset, n, 48)
		if ok and a then
			img.Image = a.Url
			img.ImageRectSize = a.ImageRectSize
			img.ImageRectOffset = a.ImageRectOffset
			return true
		end
	end
	return false
end

